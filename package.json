{
  "name": "nexus",
  "version": "0.1.0",
  "description": "A production-grade terminal Coding Agent. Context is king, tools first, human in the loop.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "nexus": "src/index.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "test:unit": "bun test tests/unit/",
    "test:integration": "bun test tests/integration/",
    "lint": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.0",
    "@ai-sdk/openai": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@xenova/transformers": "^2.17.2",
    "ai": "^4.3.0",
    "chalk": "^5.4.1",
    "diff": "^7.0.0",
    "ink": "^5.2.0",
    "react": "^18.3.1",
    "smol-toml": "^1.3.1",
    "tree-sitter-wasm": "^1.1.2",
    "web-tree-sitter": "^0.26.11",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "@types/diff": "^7.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.18",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}

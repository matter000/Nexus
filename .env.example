# Nexus 环境变量示例
# 复制本文件为 .env 并填入真实值。API Key 也可通过 `nexus /login` 交互式存入
# ~/.nexus/secrets.toml（推荐，权限 0600）。当两者都存在时，环境变量优先级更高。

# ===== 模型 Provider API Key =====

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxx

# OpenAI (GPT)
OPENAI_API_KEY=sk-xxxx

# DeepSeek
DEEPSEEK_API_KEY=sk-xxxx

# 自定义 OpenAI 兼容 provider（如本地模型、第三方网关）
CUSTOM_API_KEY=sk-xxxx
CUSTOM_BASE_URL=https://api.example.com/v1
CUSTOM_DEFAULT_MODEL=your-model-id

# ===== 调试 =====

# 调试日志开关：设为 0 禁用，其他值或不设置则开启（默认开启）
NEXUS_DEBUG=1

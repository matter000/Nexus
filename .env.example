# Nexus 环境变量示例
# 复制本文件为 .env 并填入真实值。API Key 也可通过 `nexus /login` 交互式存入
# ~/.nexus/secrets.toml（推荐，权限 0600）。当两者都存在时，环境变量优先级更高。

# ===== 模型 Provider API Key =====

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxx

# OpenAI (GPT)
OPENAI_API_KEY=sk-xxxx

# DeepSeek
DEEPSEEK_API_KEY=sk-xxxx

# 自定义 OpenAI 兼容 provider（如本地模型、第三方网关）
CUSTOM_API_KEY=sk-xxxx
CUSTOM_BASE_URL=https://api.example.com/v1
CUSTOM_DEFAULT_MODEL=your-model-id

# ===== 调试 =====

# 调试日志开关：设为 0 禁用，其他值或不设置则开启（默认开启）
NEXUS_DEBUG=1

# ===== Loop Engineering（循环工程） =====
# 以下配置位于 .nexus/config.toml（非环境变量），此处仅作说明：
#
#   [limits]
#   max_auto_retries = 1   # 自动修复循环默认开启 1 次（执行错误/验证失败/证据门禁失败时自动重试；设 0 关闭）
#
#   [evidence]             # 确定性证据门禁（lint/typecheck/test），任务完成且改动代码时运行
#   lint_command = "bun run lint"
#   typecheck_command = "bunx tsc --noEmit"
#   test_command = "bun test"
#   timeout_ms = 180       # 单条命令超时（秒），超时按跳过处理，不误判失败触发修复循环
#
# 未配置时自动探测项目 package.json scripts（lint/typecheck/test 常见名），无则跳过（退化为原有验证行为）
#
#   [loops.ci-triage]      # 本地 Automations（会话内自动心跳，/loops 管理）
#   schedule = "2h"         # 间隔：m/h（最小 1m）
#   prompt = "检查 CI 失败并修复"
#   gates = ["lint", "test"] # 每轮证据门禁（可选）
#   max_cost = 5            # 每轮成本上限（可选，默认 $2）
#   enabled = true          # 可选，默认 true

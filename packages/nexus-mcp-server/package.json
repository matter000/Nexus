{
  "name": "@nexus/mcp-server",
  "version": "1.0.0",
  "description": "Nexus MCP Server — 让 Cursor/VSCode/Claude Desktop 通过 MCP 协议调用 Nexus 工具（read_file, edit_file, bash, grep）",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "nexus-mcp": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coding-agent",
    "nexus",
    "cli-tools",
    "ai",
    "code-editing"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  }
}
